---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import Header from '../components/ui/Header.astro';
import { siteName, siteTagline } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  current?: 'contents' | 'plans' | 'myths' | 'schema' | 'about';
}
const { title, description = siteTagline, current } = Astro.props;
const fullTitle = title === siteName ? `${siteName} · ${siteTagline}` : `${title} · ${siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Header current={current} />
    <slot />
    <footer class="site-footer">
      <div class="bar">
        <span>{siteName} · {siteTagline}</span>
        <a href="/sql/">Contents</a>
        <a href="/sql/example-schema/">Example schema</a>
        <a href="/sql/about/">About</a>
        <span style="margin-left:auto">Based on the book by Markus Winand. Rewritten; the original is at <a href="https://use-the-index-luke.com" rel="noopener">use-the-index-luke.com</a>.</span>
      </div>
    </footer>
  </body>
</html>
