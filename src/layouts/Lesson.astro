---
import Base from './Base.astro';
import ChapterNav from '../components/ui/ChapterNav.astro';
import type { MarkdownHeading } from 'astro';

interface Link { href: string; title: string; sub?: string }
interface Props {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  crumbs: Link[];
  chapterSlug?: string;
  kind?: 'page' | 'reference' | 'index';
  recap?: string[];
  headings?: MarkdownHeading[];
  prev?: Link;
  next?: Link;
  source?: string;
  current?: 'contents' | 'plans' | 'myths' | 'schema' | 'about';
}
const { id, title, subtitle, description, crumbs, chapterSlug, kind = 'page', recap = [], headings = [], prev, next, source, current = 'contents' } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---
<Base title={title} description={description} current={current}>
  <div class="lesson-shell">
    <ChapterNav currentId={id} currentChapter={chapterSlug} />
    <main class="article" data-pagefind-body>
      <p class="crumb" data-pagefind-ignore>{crumbs.map((c, i) => <>{i > 0 && <span>›</span>}<a href={c.href}>{c.title}</a></>)}</p>
      <h1>{title}</h1>
      {subtitle && <p class="lede">{subtitle}</p>}
      <div class="prose">
        <slot />
      </div>
      {recap.length > 0 && (
        <section class="summary" aria-labelledby="recap-h" data-pagefind-ignore>
          <h2 id="recap-h">In short</h2>
          <ul>{recap.map((r) => <li>{r}</li>)}</ul>
        </section>
      )}
      {source && <p class="source-note" data-pagefind-ignore>This page rewrites <a href={source} rel="noopener">the corresponding page</a> of Markus Winand's <em>Use The Index, Luke</em>. Read the original for the author's own wording.</p>}
      {(prev || next) && (
        <nav class="pager" aria-label="Page navigation" data-pagefind-ignore>
          {prev ? <a href={prev.href} class="prev"><small>Previous</small><b>{prev.title}</b></a> : <span></span>}
          {next && <a href={next.href} class="next"><small>Next</small><b>{next.title}</b></a>}
        </nav>
      )}
    </main>
    {h2s.length > 1 && (
      <aside class="on-page" aria-label="On this page">
        <h2>On this page</h2>
        <ol>{h2s.map((h) => <li><a href={`#${h.slug}`} data-target={h.slug}>{h.text}</a></li>)}</ol>
      </aside>
    )}
  </div>
</Base>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.on-page a[data-target]')];
  if (links.length && 'IntersectionObserver' in window) {
    const map = new Map(links.map((a) => [a.dataset.target!, a]));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { links.forEach((a) => a.classList.remove('active')); map.get((e.target as HTMLElement).id)?.classList.add('active'); }
    }, { rootMargin: '-15% 0px -75% 0px' });
    for (const id of map.keys()) { const el = document.getElementById(id); if (el) io.observe(el); }
  }
</script>
