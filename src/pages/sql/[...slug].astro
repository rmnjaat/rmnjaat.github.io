---
import { getCollection, render } from 'astro:content';
import Lesson from '../../layouts/Lesson.astro';
import { chapters, referenceSections } from '../../lib/site';
import { getOrderedLessons, toNavItem, getReferenceBySection, lessonHref } from '../../lib/nav';

export async function getStaticPaths() {
  const pages = await getOrderedLessons();
  const refs = await getCollection('reference');
  const paths: { params: { slug: string }; props: Record<string, unknown> }[] = [];
  pages.forEach((entry, i) => {
    paths.push({ params: { slug: entry.id }, props: { kind: 'page', entry, prev: pages[i - 1] ?? null, next: pages[i + 1] ?? null } });
  });
  for (const c of chapters) if (!pages.some((l) => l.id === c.slug)) paths.push({ params: { slug: c.slug }, props: { kind: 'chapter', chapter: c } });
  for (const r of refs) paths.push({ params: { slug: r.id }, props: { kind: 'reference', entry: r } });
  for (const s of referenceSections) if (!refs.some((r) => r.id === s.slug)) paths.push({ params: { slug: s.slug }, props: { kind: 'section', section: s } });
  return paths;
}

const props = Astro.props as any;
const kind: 'page' | 'chapter' | 'reference' | 'section' = props.kind;
const sectionCurrent = (slug: string) => (slug === 'explain-plan' ? 'plans' : slug === 'myth-directory' ? 'myths' : slug === 'example-schema' ? 'schema' : slug === 'about' ? 'about' : 'contents');
const chapterTitle = (c: { n: number; title: string }) => (c.n === 0 ? c.title : `Chapter ${c.n}: ${c.title}`);

let Content: any = null;
let headings: any[] = [];
let layoutProps: any;

if (kind === 'page') {
  const { entry, prev, next } = props;
  const r = await render(entry);
  Content = r.Content; headings = r.headings;
  const ch = chapters.find((c) => c.slug === entry.data.chapter)!;
  const isChapterRoot = entry.id === ch.slug;
  layoutProps = {
    id: entry.id, title: entry.data.title, subtitle: entry.data.subtitle, description: entry.data.summary,
    crumbs: isChapterRoot ? [{ href: '/', title: 'Home' }] : [{ href: '/', title: 'Home' }, { href: `/sql/${ch.slug}/`, title: chapterTitle(ch) }],
    chapterSlug: ch.slug, kind: 'page', recap: entry.data.recap, source: entry.data.source,
    prev: prev ? { href: lessonHref(prev.id), title: prev.data.title } : undefined,
    next: next ? { href: lessonHref(next.id), title: next.data.title } : undefined,
    current: 'contents',
  };
} else if (kind === 'reference') {
  const { entry } = props;
  const r = await render(entry);
  Content = r.Content; headings = r.headings;
  const sec = referenceSections.find((s) => s.slug === entry.data.section)!;
  const list = (await getReferenceBySection()).get(sec.slug) ?? [];
  const i = list.findIndex((x) => x.id === entry.id);
  const prev = list[i - 1]; const next = list[i + 1];
  const isSectionRoot = entry.id === sec.slug;
  layoutProps = {
    id: entry.id, title: entry.data.title, subtitle: entry.data.subtitle, description: entry.data.summary,
    crumbs: isSectionRoot ? [{ href: '/', title: 'Home' }] : [{ href: '/', title: 'Home' }, { href: `/sql/${sec.slug}/`, title: sec.title }],
    chapterSlug: sec.slug, kind: 'reference', source: entry.data.source,
    prev: prev ? { href: lessonHref(prev.id), title: prev.data.title } : undefined,
    next: next ? { href: lessonHref(next.id), title: next.data.title } : undefined,
    current: sectionCurrent(sec.slug),
  };
} else if (kind === 'chapter') {
  const ch = props.chapter;
  const list = (await getOrderedLessons()).filter((l) => l.data.chapter === ch.slug).map(toNavItem);
  layoutProps = { id: ch.slug, title: chapterTitle(ch), subtitle: ch.tagline, description: ch.intro, crumbs: [{ href: '/', title: 'Home' }], chapterSlug: ch.slug, kind: 'index', current: 'contents' };
  props.list = list;
} else {
  const sec = props.section;
  const list = ((await getReferenceBySection()).get(sec.slug) ?? []).map((r) => ({ href: lessonHref(r.id), title: r.data.title, subtitle: r.data.subtitle }));
  layoutProps = { id: sec.slug, title: sec.title, subtitle: sec.tagline, description: sec.intro, crumbs: [{ href: '/', title: 'Home' }], chapterSlug: sec.slug, kind: 'index', current: sectionCurrent(sec.slug) };
  props.list = list;
}
---
<Lesson {...layoutProps} headings={headings}>
  {Content && <Content />}
  {kind === 'chapter' && (
    <>
      <p class="chapter-intro">{props.chapter.intro}</p>
      <ol class="page-list">
        {props.list.map((l: any) => (
          <li data-depth={String(l.depth)}>
            <a href={l.href}><span class="n">{props.chapter.n}.{l.label}</span><span><span class="t">{l.title}</span><span class="sub">{l.subtitle}</span></span></a>
          </li>
        ))}
      </ol>
    </>
  )}
  {kind === 'section' && (
    <>
      {props.section.intro && <p class="chapter-intro">{props.section.intro}</p>}
      <ol class="page-list">
        {props.list.map((l: any) => (
          <li data-depth="1"><a href={l.href}><span class="n"></span><span><span class="t">{l.title}</span><span class="sub">{l.subtitle}</span></span></a></li>
        ))}
      </ol>
    </>
  )}
</Lesson>
