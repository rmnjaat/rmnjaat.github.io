---
import Base from '../../layouts/Base.astro';
import { chapters } from '../../lib/site';
import { getOrderedLessons, toNavItem } from '../../lib/nav';
const items = (await getOrderedLessons()).map(toNavItem).filter((i) => i.kind !== 'lesson');
const byChapter = new Map(chapters.map((c) => [c.slug, [] as typeof items]));
for (const it of items) byChapter.get(it.id.split('/')[0])?.push(it);
---
<Base title="Practice" description="Exercise sets and unit checks for every unit of the course." current="practice">
  <div class="wrap practice-index">
    <p class="crumb"><a href="/">Course</a><span>›</span><span>Practice</span></p>
    <h1 style="font-size: clamp(28px, 4vw, 36px); font-weight: 600; letter-spacing: -.02em; margin: 0 0 var(--s2)">Practice</h1>
    <p class="lede">Every unit ends with a practice set you solve in the playground and a short unit check. They are listed here so you can come back to them after the reading.</p>
    {chapters.map((c) => {
      const list = byChapter.get(c.slug) ?? [];
      if (!list.length) return null;
      return (
        <section>
          <h2 style="font-size: 22px; font-weight: 600; margin: var(--s6) 0 var(--s2)"><span style="font-family: var(--font-mono); font-size: 13px; color: var(--mute); margin-right: 10px">{c.n}</span><a href={`/sql/${c.slug}/`} style="color: inherit; text-decoration: none">{c.title}</a></h2>
          <ol class="lesson-list" data-lesson-list style="margin-top: var(--s2)">
            {list.map((l) => <li data-id={l.id} class={`t-${l.kind}`}><a href={l.href}><span class="ic" aria-hidden="true"></span><span><span class="t">{l.title}</span><span class="sub">{l.subtitle}</span></span><span class="min">{l.kind} · {l.minutes} min</span></a></li>)}
          </ol>
        </section>
      );
    })}
  </div>
</Base>
<script>
  import { getDone } from '../../lib/prefs';
  const done = getDone();
  document.querySelectorAll<HTMLElement>('[data-lesson-list] li[data-id]').forEach((li) => li.classList.toggle('done', done.has(li.dataset.id!)));
</script>
