---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="wrap" style="max-width: 720px">
    <h1 style="font-size: 32px; font-weight: 600; margin: 0 0 var(--s2)">That page is not in the index.</h1>
    <p style="color: var(--ink-2); font-size: 1.15rem">Try the <a href="/sql/">table of contents</a> or search with <kbd>/</kbd>.</p>
  </div>
</Base>
