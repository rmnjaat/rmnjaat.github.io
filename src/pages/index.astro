---
import Base from '../layouts/Base.astro';
import Contents from '../components/ui/Contents.astro';
import { siteName } from '../lib/site';
---
<Base title={siteName} current="contents">
  <div class="wrap home">
    <h1>SQL indexing for developers</h1>
    <p class="sub">How a database finds your rows, why some queries are slow even with an index, and how to design indexes from the queries you write. Vendor-neutral, with notes for PostgreSQL, MySQL, Oracle, SQL Server, Db2 and SQLite.</p>
    <p class="sub small">A rewritten edition of Markus Winand's <a href="https://use-the-index-luke.com" rel="noopener">Use The Index, Luke</a>. Read it front to back, or jump to the chapter you need.</p>
    <Contents />
  </div>
</Base>
