---
interface Props { kind?: 'note' | 'important' | 'tip' | 'warning'; title?: string }
const { kind = 'note', title } = Astro.props;
const titles = { note: 'Note', important: 'Important', tip: 'Tip', warning: 'Warning' };
---
<aside class={`callout ${kind}`} role="note">
  {kind === 'important' && <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 6v5M10 14v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
  {kind === 'warning' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 2.5l8 14H2z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 8v4M10 14.5v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>}
  {kind === 'tip' && <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7 15h6M8 17.5h4M10 2.5a5.5 5.5 0 0 0-3 10.1V13h6v-.4a5.5 5.5 0 0 0-3-10.1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>}
  {kind === 'note' && <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3.5" y="3.5" width="13" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M7 8h6M7 11h6M7 14h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>}
  <div>
    <div class="title">{title ?? titles[kind]}</div>
    <slot />
  </div>
</aside>
