---
import PagefindConfig from 'astro-pagefind/components/PagefindConfig.astro';
import { siteName } from '../../lib/site';
interface Props { current?: string }
const { current } = Astro.props;
const nav = [
  { key: 'contents', href: '/sql/', label: 'Contents' },
  { key: 'plans', href: '/sql/explain-plan/', label: 'Execution plans' },
  { key: 'myths', href: '/sql/myth-directory/', label: 'Myths' },
  { key: 'schema', href: '/sql/example-schema/', label: 'Example schema' },
  { key: 'about', href: '/sql/about/', label: 'About' },
];
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={siteName}><i>Ix</i><span>Use The Index, Luke</span></a>
    <nav class="site-nav" aria-label="Site">
      {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="site-tools">
      <button class="tool-btn" type="button" id="search-open" aria-label="Search">
        <svg width="15" height="15" viewBox="0 0 15 15" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.75" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 10l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <span>Search</span>
      </button>
    </div>
  </div>
  <dialog class="search" id="search-dialog" aria-label="Search the site">
    <div class="inner">
      <div class="search-row">
        <pagefind-input instance="site" placeholder="Search all pages" autofocus></pagefind-input>
        <button class="btn small" type="button" id="search-close">Close</button>
      </div>
      <pagefind-summary instance="site" default-message="Type to search every page."></pagefind-summary>
      <pagefind-results instance="site" max-results="40" hide-sub-results></pagefind-results>
    </div>
  </dialog>
  <PagefindConfig instance="site" excerpt-length="24" />
</header>
<script>
  const dlg = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const open = () => { if (!dlg) return; dlg.showModal(); const pi = dlg.querySelector('pagefind-input') as HTMLElement | null; (pi?.shadowRoot?.querySelector('input') as HTMLInputElement | null)?.focus(); };
  document.getElementById('search-open')?.addEventListener('click', open);
  document.getElementById('search-close')?.addEventListener('click', () => dlg?.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable || t.tagName === 'PAGEFIND-INPUT');
    if (e.key === '/' && !typing && dlg && !dlg.open) { e.preventDefault(); open(); }
  });
</script>
