---
import { chapters, referenceSections } from '../../lib/site';
import { getOrderedLessons, toNavItem } from '../../lib/nav';
interface Props { currentId?: string; currentChapter?: string }
const { currentId, currentChapter } = Astro.props;
const pages = await getOrderedLessons();
const byChapter = new Map<string, ReturnType<typeof toNavItem>[]>();
for (const c of chapters) byChapter.set(c.slug, []);
for (const l of pages) byChapter.get(l.data.chapter)?.push(toNavItem(l));
---
<button class="btn tree-toggle" type="button" id="tree-toggle" aria-expanded="false" aria-controls="chapter-nav">☰ Contents</button>
<nav class="tree" aria-label="Contents" id="chapter-nav">
  {chapters.map((c) => {
    const items = byChapter.get(c.slug) ?? [];
    const single = items.length === 1 && items[0].id === c.slug;
    if (single) {
      const it = items[0];
      return <div class="unit open"><ol style="padding-left:0"><li><a href={it.href} aria-current={currentId === it.id ? 'page' : undefined}><span class="n">{c.n}</span><span>{c.title}</span></a></li></ol></div>;
    }
    return (
      <div class={`unit ${c.slug === currentChapter ? 'open' : ''}`} data-unit={c.slug}>
        <button type="button" aria-expanded={c.slug === currentChapter ? 'true' : 'false'}><span class="n">{c.n}</span><span>{c.title}</span><span class="chev" aria-hidden="true"></span></button>
        <ol>
          <li data-depth="1"><a href={`/sql/${c.slug}/`} aria-current={currentId === c.slug ? 'page' : undefined}><span class="n"></span><span class="ov">Overview</span></a></li>
          {items.map((it) => (
            <li data-depth={String(it.depth)}>
              <a href={it.href} aria-current={currentId === it.id ? 'page' : undefined}><span class="n">{it.label}</span><span>{it.title}</span></a>
            </li>
          ))}
        </ol>
      </div>
    );
  })}
  <div class="ref">
    {referenceSections.map((s) => <a href={`/sql/${s.slug}/`} aria-current={currentChapter === s.slug ? 'page' : undefined}>{s.title}</a>)}
  </div>
</nav>
<script>
  const nav = document.getElementById('chapter-nav');
  nav?.querySelectorAll<HTMLButtonElement>('.unit > button').forEach((b) => b.addEventListener('click', () => {
    const u = b.parentElement!; const open = u.classList.toggle('open'); b.setAttribute('aria-expanded', String(open));
  }));
  const toggle = document.getElementById('tree-toggle');
  toggle?.addEventListener('click', () => { const open = nav?.classList.toggle('open'); toggle.setAttribute('aria-expanded', String(!!open)); });
</script>
