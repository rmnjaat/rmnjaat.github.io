---
/**
 * Try-it block: numbered tasks that tick themselves off when a playground query
 * on the page matches, plus hints behind disclosure.
 *
 * <TryIt id="1.2" tasks={[
 *   { text: 'Look up employee 57 …', sql: 'employee_id\\s*=\\s*57', plan: 'SEARCH' },
 *   { text: 'Create an index on last_name', sql: 'create\\s+index' },
 * ]}>
 *   <Playground client:visible … />
 *   <Fragment slot="hints"> <details class="hint">…</details> </Fragment>
 * </TryIt>
 *
 * `sql` and `plan` are case-insensitive regexes tested against the query that ran and the plan it produced.
 */
import Playground from '../figures/Playground';
interface Task { text: string; sql?: string; plan?: string }
interface Props { id: string; title?: string; tasks: Task[]; sql?: string; setup?: string; pgTitle?: string }
const { id, title = `Exercise ${id}`, tasks, sql, setup, pgTitle } = Astro.props;
const uid = id.replace(/[^a-z0-9]/gi, '-');
---
<section class="tryit" data-tryit={id} data-tasks={JSON.stringify(tasks.map((t) => ({ sql: t.sql ?? null, plan: t.plan ?? null })))}>
  <div class="th"><span>{title}</span><span class="cnt" data-cnt>0 of {tasks.length} tasks done</span></div>
  <div class="tb">
    <ol class="tasks">
      {tasks.map((t, i) => (
        <li><input type="checkbox" id={`t-${uid}-${i}`} data-i={i} /><label for={`t-${uid}-${i}`} set:html={t.text} /></li>
      ))}
    </ol>
    {sql ? <Playground client:visible title={pgTitle ?? `exercise-${uid}`} sql={sql} setup={setup} /> : <slot />}
    {Astro.slots.has('hints') && <div class="hintrow"><slot name="hints" /></div>}
  </div>
</section>
<script>
  import { getTasks, setTasks } from '../../lib/prefs';
  const lessonId = document.querySelector<HTMLElement>('main[data-lesson-id]')?.dataset.lessonId ?? location.pathname;
  document.querySelectorAll<HTMLElement>('[data-tryit]').forEach((box) => {
    const key = `${lessonId}#${box.dataset.tryit}`;
    const specs: { sql: string | null; plan: string | null }[] = JSON.parse(box.dataset.tasks || '[]');
    const inputs = [...box.querySelectorAll<HTMLInputElement>('.tasks input')];
    let state = getTasks(key); if (state.length !== inputs.length) state = inputs.map(() => false);
    const paint = () => {
      inputs.forEach((c, i) => { c.checked = !!state[i]; c.closest('li')?.classList.toggle('done', !!state[i]); });
      const n = state.filter(Boolean).length; const cnt = box.querySelector('[data-cnt]'); if (cnt) cnt.textContent = `${n} of ${inputs.length} tasks done`;
    };
    inputs.forEach((c, i) => c.addEventListener('change', () => { state[i] = c.checked; setTasks(key, state); paint(); }));
    window.addEventListener('util:ran', (ev) => {
      const d = (ev as CustomEvent<{ sql: string; plan: string; host: HTMLElement | null }>).detail;
      if (d.host && !box.contains(d.host)) return;
      specs.forEach((s, i) => {
        const okSql = !s.sql || new RegExp(s.sql, 'i').test(d.sql);
        const okPlan = !s.plan || new RegExp(s.plan, 'i').test(d.plan);
        if (okSql && okPlan && (s.sql || s.plan)) state[i] = true;
      });
      setTasks(key, state); paint();
    });
    paint();
  });
</script>
